root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Treat selected opinionated style rules as build errors; the style gate checks the complete rule set.
dotnet_diagnostic.IDE0090.severity = error
dotnet_diagnostic.IDE0130.severity = error
dotnet_diagnostic.IDE0290.severity = error
dotnet_diagnostic.MSTEST0049.severity = error
dotnet_analyzer_diagnostic.category-Interoperability.severity = error
dotnet_style_namespace_match_folder = true:error
dotnet_style_prefer_collection_expression = true:error
csharp_prefer_braces = true:error
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = false:error
dotnet_style_require_accessibility_modifiers = always:error
dotnet_style_prefer_auto_properties = true:error
dotnet_style_prefer_compound_assignment = true:error
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
dotnet_style_prefer_null_propagation = true:error
dotnet_style_prefer_simplified_boolean_expressions = true:error
dotnet_style_prefer_simplified_interpolation = true:error
