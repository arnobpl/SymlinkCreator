<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>SymlinkCreator</RootNamespace>
    <AssemblyName>SymlinkCreator</AssemblyName>
    <Product>SymlinkCreator</Product>
    <AssemblyTitle>Symlink Creator</AssemblyTitle>
    <Description>A Windows desktop application for creating symbolic links</Description>
    <Company>Arnob Paul</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>resources\icons\MainIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <EnableWinAppRunSupport>true</EnableWinAppRunSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="..\scripts\GeneratePri.targets" />

  <Target Name="ValidatePlatform" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(RuntimeIdentifier)' == ''"
      Text="Unsupported platform '$(Platform)'. Supported platforms are x64 and ARM64." />
  </Target>

  <ItemGroup>
    <Content Include="resources\icons\MainIcon.ico">
      <Link>Assets\MainIcon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(PinnedWindowsSdkBuildToolsVersion)" />
    <!-- Keep this deliberate modular set aligned with the WinGet runtime dependency; the umbrella package adds unused AI/ML/Search/Widgets payloads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.0.15" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SymlinkCreator.Application\SymlinkCreator.Application.csproj" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Keep the release framework-dependent; runtime prerequisites are installed separately. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
