#!/bin/sh

set -eu

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

git diff --cached --check

if ! command -v pwsh >/dev/null 2>&1; then
    echo >&2 "PowerShell 7.4 or newer is required for pre-commit checks. Install it and retry."
    exit 1
fi

if ! pwsh -NoProfile -File ./scripts/Build.ps1 -Verify; then
    echo >&2
    echo >&2 "Pre-commit verification failed."
    echo >&2 "Run 'pwsh -NoProfile -File ./scripts/Build.ps1 -Fix' to apply available formatting fixes."
    echo >&2 "Review the changes, stage them, and retry the commit."
    exit 1
fi
