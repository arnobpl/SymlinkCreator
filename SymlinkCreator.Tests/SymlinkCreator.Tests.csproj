<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Platforms>x64;ARM64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
    <Nullable>enable</Nullable>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\..\SymlinkCreator.Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SymlinkCreator.Application\SymlinkCreator.Application.csproj" />
    <!-- Build XAML and resources without loading the WinUI executable into testhost. -->
    <ProjectReference Include="..\SymlinkCreator.UI\SymlinkCreator.UI.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\SymlinkCreator.UI\Strings\**\Resources.resw" LinkBase="Strings" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyWinUiPriToTestOutput" AfterTargets="Build">
    <PropertyGroup>
      <WinUiRuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</WinUiRuntimeIdentifier>
      <WinUiRuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</WinUiRuntimeIdentifier>
      <WinUiOutputDirectory>$(MSBuildProjectDirectory)\..\SymlinkCreator.UI\bin\$(Platform)\$(Configuration)\$(WindowsTargetFramework)\$(WinUiRuntimeIdentifier)</WinUiOutputDirectory>
    </PropertyGroup>
    <Error
      Condition="'$(WinUiRuntimeIdentifier)' == ''"
      Text="Unsupported platform '$(Platform)'. Supported platforms are x64 and ARM64." />
    <Error
      Condition="!Exists('$(WinUiOutputDirectory)\resources.pri')"
      Text="The WinUI build did not produce resources.pri at '$(WinUiOutputDirectory)\resources.pri'." />
    <Copy SourceFiles="$(WinUiOutputDirectory)\resources.pri" DestinationFiles="$(TargetDir)resources.pri" SkipUnchangedFiles="true" />
  </Target>

</Project>
